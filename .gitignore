node_modules/

# Nothing here builds — both packages publish TypeScript source (see the root
# package.json). A dist/ appearing means someone added a bundler step; these
# two lines keep the artefact out of git while that gets reverted.
dist/
build/

# npm debug output
npm-debug.log*
*.tsbuildinfo

# Never commit a registry token. The committed .npmrc references
# ${NODE_AUTH_TOKEN} from the environment and must stay that way — this repo is
# public.
.npmrc.local

.DS_Store

# Storybook static build output — CI builds it to prove the workbench still
# compiles, and pages.yml builds its own copy to deploy; nothing serves the
# local one.
storybook-static/

# Vitest coverage report (npm run test:coverage) — generated, never committed.
coverage/

# Story captures (npm run screenshots). They belong in a PR body, uploaded as a
# repository attachment — see the design-system-pr skill for why a screenshot
# committed to a branch is exactly the thing that later 404s.
.screenshots/
